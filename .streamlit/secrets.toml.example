# Copy to .streamlit/secrets.toml (git-ignored) or paste into the hosting platform's "Secrets" box.
# The app copies these into environment variables at startup. Never commit real keys.
LLM_PROVIDER = "anthropic"
LLM_API_KEY = "put-your-key-here"
LLM_MODEL = "your-model-name"
# Optional separate vision model settings:
# VLM_PROVIDER = "gemini"
# VLM_API_KEY = "..."
# VLM_MODEL = "..."
